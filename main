        padding: 28px 32px 32px;
      }

      .field {
        margin-bottom: 24px;
      }

      label {
        display: block;
        margin-bottom: 10px;
        font-size: 1rem;
        font-weight: 700;
      }

      input[type="url"],
      input[type="file"] {
        width: 100%;
      }

      input[type="url"] {
        border: 1px solid var(--border);
        background: #f9fbff;
        color: var(--text);
        border-radius: 14px;
        padding: 16px 18px;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      input[type="url"]:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(31, 111, 235, 0.08);
      }

      .upload-box {
        border: 1.5px dashed #b9cce8;
